# --- Server ---
PORT=8000
APP_BASE_URL=http://localhost

# --- Database (SQLite ไฟล์เก็บที่ backend/prisma/data) ---
DATABASE_URL="file:./data/school_queue.db"

# --- SMTP (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="โรงเรียน (School Queue) <no-reply@school.local>"
